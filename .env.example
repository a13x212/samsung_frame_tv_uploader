# Port for the custom Next.js server
PORT=3000

# App name shown in TV pairing dialog (max ~20 chars)
TV_APP_NAME="Frame Uploader"

# Where to store TV tokens (relative to project root)
TOKEN_STORE_PATH=./data/tv-tokens.json

# Discovery timeouts (ms)
SSDP_TIMEOUT_MS=4000
NETWORK_SCAN_TIMEOUT_MS=500

# Upload constraints
MAX_UPLOAD_SIZE_MB=100
TARGET_IMAGE_QUALITY=90

# Express "trust proxy" setting. Set ONLY when running behind a reverse proxy
# (nginx, Caddy, Traefik...). Leave empty otherwise: trusting X-Forwarded-For
# without a proxy lets clients spoof their IP and bypass rate limits.
# Accepts a hop count (1), true/false, "loopback", or a CIDR/IP list.
TRUST_PROXY=
